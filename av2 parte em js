function ir(p) {
    var pags = document.querySelectorAll('.pag');
    var i = 0;
    while (i < pags.length) {
        pags[i].classList.remove('on');
        i = i + 1;
    }
    document.getElementById('pag-' + p).classList.add('on');
    window.scrollTo(0, 0);
    if (p === 'agendamento') renderCal();
}

function abrirLogin() {
    document.getElementById('ov-login').classList.add('on');
    document.getElementById('t-login').style.display = 'block';
    document.getElementById('t-reg').style.display = 'none';
}

function fecharLogin() {
    document.getElementById('ov-login').classList.remove('on');
}

document.getElementById('ov-login').onclick = function (e) {
    if (e.target === this) fecharLogin();
};

function post(action, dados, callback) {
    var xhr = new XMLHttpRequest();
    var fd = new FormData();
    fd.append('action', action);

    var k;
    for (k in dados) {
        fd.append(k, dados[k]);
    }

    xhr.open('POST', 'index.php');
    xhr.onload = function () {
        callback(JSON.parse(xhr.responseText));
    };
    xhr.send(fd);
}

function login() {
    post('login', {
        email: v('l-email'),
        senha: v('l-senha')
    }, function (r) {
        msg('msg-l', r.mensagem, r.sucesso);
        if (r.sucesso) setTimeout(function () {
            location.reload();
        }, 700);
    });
}

function registro() {
    if (v('r-nome') === '' || v('r-email') === '' || v('r-senha') === '') {
        msg('msg-r', 'Preencha tudo.', false);
        return;
    }

    post('criar_conta', {
        nome: v('r-nome'),
        email: v('r-email'),
        senha: v('r-senha')
    }, function (r) {
        msg('msg-r', r.mensagem, r.sucesso);
        if (r.sucesso) setTimeout(function () {
            location.reload();
        }, 700);
    });
}

var cal = {
    ano: new Date().getFullYear(),
    mes: new Date().getMonth(),
    sel: ''
};

var MESES = ['Janeiro','Fevereiro','Março','Abril','Maio','Junho','Julho','Agosto','Setembro','Outubro','Novembro','Dezembro'];

function renderCal() {
    var el = document.getElementById('cal');
    if (!el) return;

    var ano = cal.ano;
    var mes = cal.mes;
    var hoje = new Date();
    var pri = new Date(ano, mes, 1).getDay();
    var tot = new Date(ano, mes + 1, 0).getDate();
    var h = '';
    var i = 0;

    h += '<div><button onclick="mudaMes(-1)">‹</button> ';
    h += '<strong>' + MESES[mes] + ' ' + ano + '</strong> ';
    h += '<button onclick="mudaMes(1)">›</button></div>';
    h += '<div class="cal-grid">';

    while (i < pri) {
        h += '<div></div>';
        i = i + 1;
    }

    var d = 1;
    while (d <= tot) {
        var dt = ano + '-' + String(mes + 1).padStart(2, '0') + '-' + String(d).padStart(2, '0');
        var pass = new Date(ano, mes, d) < new Date(hoje.getFullYear(), hoje.getMonth(), hoje.getDate());
        h += '<div class="d' + (cal.sel === dt ? ' sel' : '') + (pass ? ' off' : '') + '"';
        if (!pass) h += ' onclick="selDia(\'' + dt + '\')"';
        h += '>' + d + '</div>';
        d = d + 1;
    }

    h += '</div>';
    el.innerHTML = h;
}

function mudaMes(d) {
    cal.mes = cal.mes + d;
    if (cal.mes < 0) {
        cal.mes = 11;
        cal.ano = cal.ano - 1;
    }
    if (cal.mes > 11) {
        cal.mes = 0;
        cal.ano = cal.ano + 1;
    }
    renderCal();
}

function selDia(d) {
    cal.sel = d;
    document.getElementById('data-sel').value = d;
    renderCal();
}

function agendar() {
    var data = document.getElementById('data-sel').value;
    var hora = document.getElementById('hora').value;
    var checks = document.querySelectorAll('#checks input:checked');
    var serv = [];
    var i = 0;

    while (i < checks.length) {
        serv.push(checks[i].value);
        i = i + 1;
    }

    if (data === '' || hora === '' || serv.length === 0) {
        msg('msg-agd', 'Preencha tudo.', false);
        return;
    }

    var novo = {
        id: 'l' + Date.now(),
        data: data,
        hora: hora,
        servico: serv.join('+')
    };

    var local = JSON.parse(localStorage.getItem('eb_agd') || '[]');
    local.push(novo);
    localStorage.setItem('eb_agd', JSON.stringify(local));
    sessionStorage.setItem('ag', JSON.stringify(novo));

    post('agendar', novo, function () {});

    msg('msg-agd', 'Agendamento salvo!', true);
    setTimeout(function () {
        ir('pagamento');
    }, 800);
}

function pagar() {
    var ag = JSON.parse(sessionStorage.getItem('ag') || '{}');
    post('pagar', { id: ag.id }, function () {});
    sessionStorage.removeItem('ag');
    document.getElementById('txt-conf').textContent =
        'Serviço: ' + ag.servico + ' | ' + ag.data + ' ' + ag.hora + ' | Pagamento confirmado';
    ir('conf');
}

function v(id) {
    var el = document.getElementById(id);
    if (!el) return '';
    return el.value.trim();
}

function msg(id, texto, ok) {
    var el = document.getElementById(id);
    if (!el) return;
    el.textContent = texto;
    el.className = 'msg ' + (ok ? 'ok' : 'err');
}
