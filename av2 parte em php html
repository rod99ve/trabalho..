<?php
session_start();

define('DB_HOST', 'localhost');
define('DB_USER', 'root');
define('DB_PASS', '');
define('DB_NAME', 'espaco_beleza');

function conectar() {
    static $pdo;
    if ($pdo) return $pdo;
    $pdo = new PDO(
        "mysql:host=" . DB_HOST . ";dbname=" . DB_NAME . ";charset=utf8",
        DB_USER,
        DB_PASS
    );
    return $pdo;
}

function criarTabelas() {
    $pdo = conectar();

    $pdo->exec("CREATE TABLE IF NOT EXISTS clientes (
        id INT AUTO_INCREMENT PRIMARY KEY,
        nome VARCHAR(100),
        email VARCHAR(100),
        senha VARCHAR(32)
    )");

    $pdo->exec("CREATE TABLE IF NOT EXISTS agendamentos (
        id INT AUTO_INCREMENT PRIMARY KEY,
        nome VARCHAR(100),
        email VARCHAR(100),
        servico VARCHAR(100),
        data_agend DATE,
        hora_agend TIME,
        status VARCHAR(20)
    )");

    $pdo->exec("CREATE TABLE IF NOT EXISTS pagamentos (
        id INT AUTO_INCREMENT PRIMARY KEY,
        agendamento_id INT,
        metodo VARCHAR(30)
    )");
}

criarTabelas();

if (isset($_POST['action'])) {
    header('Content-Type: application/json');
    $pdo = conectar();
    $a = $_POST['action'];

    if ($a === 'criar_conta') {
        $st = $pdo->prepare("INSERT INTO clientes VALUES (0,?,?,?)");
        $st->execute([
            $_POST['nome'],
            $_POST['email'],
            md5($_POST['senha'])
        ]);
        echo json_encode(['sucesso'=>true,'mensagem'=>'Conta criada']);
        exit;
    }

    if ($a === 'login') {
        $st = $pdo->prepare(
            "SELECT * FROM clientes WHERE email=? AND senha=?"
        );
        $st->execute([
            $_POST['email'],
            md5($_POST['senha'])
        ]);
        $u = $st->fetch();
        if ($u) {
            $_SESSION['user'] = $u;
            echo json_encode(['sucesso'=>true,'mensagem'=>'Login ok']);
        } else {
            echo json_encode(['sucesso'=>false,'mensagem'=>'Dados inválidos']);
        }
        exit;
    }

    if ($a === 'agendar') {
        $st = $pdo->prepare(
            "INSERT INTO agendamentos VALUES (0,?,?,?,?,?, 'Pendente')"
        );
        $st->execute([
            $_POST['nome'],
            $_POST['email'],
            $_POST['servico'],
            $_POST['data'],
            $_POST['hora']
        ]);
        echo json_encode(['sucesso'=>true]);
        exit;
    }

    if ($a === 'pagar') {
        $pdo->prepare(
            "INSERT INTO pagamentos VALUES (0,?, 'Simulado')"
        )->execute([$_POST['id']]);

        $pdo->prepare(
            "UPDATE agendamentos SET status='Pago' WHERE id=?"
        )->execute([$_POST['id']]);

        echo json_encode(['sucesso'=>true]);
        exit;
    }
}
